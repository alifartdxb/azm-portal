# ----------------------------------------------------------------------
# AZM Group - Production .htaccess for Hostinger
# ----------------------------------------------------------------------

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. Preferred Hostname (Optional - uncomment to force non-www)
  # RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
  # RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

  # 3. Prevent Directory Listing
  Options -Indexes

  # 4. Preserve /api/ routes (Bypass React Router)
  RewriteCond %{REQUEST_URI} ^/api/ [NC]
  RewriteRule ^ - [L]
  
  # Preserve /uploads/ routes
  RewriteCond %{REQUEST_URI} ^/uploads/ [NC]
  RewriteRule ^ - [L]

  # 5. Redirect React Routes to index.html (Supports Direct URL Refresh)
  # Preserve existing files and directories
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [QSA,L]
</IfModule>

# 6. Enable Compression (GZIP/Brotli)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# 7. Browser Caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  
  # Cache CSS, JS, and Images for 1 year
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  
  # Don't cache HTML to ensure routing works with latest index.html
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# 8. Security Headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-XSS-Protection "1; mode=block"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  # Optional: HSTS (Uncomment if SSL is fully configured and reliable)
  # Header set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# 9. Protect Sensitive Files
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
<FilesMatch "^(package\.json|package-lock\.json|server\.js|\.env|\.env\.local)$">
  Require all denied
</FilesMatch>
